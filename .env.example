# Written by `npx convex dev` (dev deployment). Vercel holds the prod values.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opt into the official local ChatGPT runtime; bind Next.js to 127.0.0.1.
CLEVEX_CHATGPT_LOCAL=0

# ---- Optional. By default each browser brings its own ChatGPT / Claude login. ----

# Long-lived token from `claude setup-token` — lets the server use your Claude plan.
CLAUDE_CODE_OAUTH_TOKEN=

# auto | tectonic | remote
CLEVEX_COMPILER=auto
CLEVEX_LATEX_REMOTE_URL=https://latex.ytotech.com/builds/sync

# Optional self-hosted gateways (OpenAI Responses / Anthropic Messages compatible).
CLEVEX_OPENAI_BASE_URL=
CLEVEX_OPENAI_API_KEY=
CLEVEX_ANTHROPIC_BASE_URL=
CLEVEX_ANTHROPIC_API_KEY=
